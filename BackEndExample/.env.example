# 請先將本檔複製為 .env，再依照自己的環境修改下方設定。
# .env 請勿上傳或分享，尤其不要公開資料庫密碼與私鑰。

# MongoDB 連線設定：改成自己的 MongoDB 帳號、密碼、主機、連接埠與資料庫名稱。
# 本機 MongoDB 通常使用 127.0.0.1；若使用雲端服務，請填服務提供的連線資訊。
DBUSER = test                 # 修改：MongoDB 使用者名稱
DBPASSWORD = password         # 修改：MongoDB 密碼
DBHOST = 127.0.0.1            # 修改：MongoDB 主機位址
DBPORT = 8974                  # 修改：MongoDB 連接埠
DBNAME = name                  # 修改：要使用的資料庫名稱

# 後端 API 監聽的連接埠。若更改此值，也要同步修改前端 src/enum/api.ts 的 API 網址。
PORT = 2083                    # 可自行更改；需與前端 API 網址的連接埠一致

# 後端執行時寫入日誌的資料夾；請填可寫入的資料夾路徑，資料夾需存在。
LogPath = logs                 # 可改為自己的日誌資料夾路徑

# 靜態資源資料夾路徑；請改成專案中實際存放資源的資料夾路徑。
assetsPath = /assets           # 修改：填實際資料夾路徑

# GET / 回傳的首頁檔案路徑；請改成實際存在的 HTML 檔案路徑。
HomePagePath = /index.html     # 修改：填實際首頁檔案路徑

# 用於簽章的私鑰；請自行產生一組隨機且不公開的字串，不要使用範例值。
privateKey = key               # 修改：替換為自己的隨機私鑰
